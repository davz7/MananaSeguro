# Variables del FRONTEND (Vite).
# Solo las que empiezan con VITE_ llegan al navegador: aquí NUNCA van secretos.
# Las variables del backend (Supabase, Etherfuse, KMS, sesión…) viven en el
# .env de la raíz del repo; ver ../.env.example.

# Client ID de Google OAuth (tipo "Aplicación web").
# Debe ser el mismo valor que GOOGLE_CLIENT_ID del backend.
VITE_GOOGLE_CLIENT_ID=

# Red de Stellar: testnet | public
VITE_STELLAR_NETWORK=testnet

# Explorador de transacciones (opcional; por defecto stellar.expert según la red)
VITE_STELLAR_EXPLORER=https://stellar.expert/explorer/testnet
