# Variables del BACKEND (Netlify Functions).
# `netlify dev` lee el archivo .env de esta carpeta (raíz del repo).
# En Netlify se configuran en Site settings → Environment variables.
# Las del frontend (VITE_*) están en CreditRoot/.env.example.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Sesión: clave HS256 de al menos 32 bytes
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SIGNING_KEY=

# Google OAuth (mismo valor que VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Custodia de llaves (AWS KMS) — ver netlify/functions/_lib/custody.js
KMS_CUSTODY_KEY_ID=
MS_AWS_REGION=us-east-1
MS_AWS_ACCESS_KEY_ID=
MS_AWS_SECRET_ACCESS_KEY=
MS_AWS_ROLE_ARN=
MS_AWS_ROLE_EXTERNAL_ID=

# Etherfuse
ETHERFUSE_API_KEY=
ETHERFUSE_ENV=sandbox

# Banxico (tasas CETES y tipo de cambio)
BANXICO_TOKEN=

# Webhooks de Etherfuse
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_SECRET_2=
WEBHOOK_ID=
WEBHOOK_ID2=

# Soroban / Stellar (opcionales: por defecto testnet)
SOROBAN_CONTRACT_ID=
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
